#############################################
# GuardianAI Production Environment Template
# Copy this file to .env and fill real values
#############################################

# -----------------------------
# Core Admin Credentials
# -----------------------------
GUARDIAN_ADMIN_USER=admin
GUARDIAN_ADMIN_PASS=CHANGE_TO_LONG_RANDOM_PASSWORD

# -----------------------------
# Runtime Service Auth
# -----------------------------
GUARDIAN_BACKEND_TOKEN=CHANGE_TO_LONG_RANDOM_TOKEN
GUARDIAN_SERVICE_AUTH_TOKEN=CHANGE_TO_LONG_RANDOM_TOKEN
GUARDIAN_SERVICE_ID=guardian-proxy

# -----------------------------
# Public URLs (Production)
# -----------------------------
# Example:
# GUARDIAN_PUBLIC_BASE_URL=https://guardian.yourdomain.com
GUARDIAN_PUBLIC_BASE_URL=https://your-domain.com
GUARDIAN_CHECKOUT_SUCCESS_URL=https://your-domain.com/site/success
GUARDIAN_CHECKOUT_CANCEL_URL=https://your-domain.com/site/cancel

# -----------------------------
# Billing Mode
# -----------------------------
# Use "live" in production
GUARDIAN_BILLING_MODE=live

# -----------------------------
# Card Payments (Stripe)
# -----------------------------
GUARDIAN_STRIPE_SECRET_KEY=CHANGE_ME_stripe_secret_key
GUARDIAN_STRIPE_PRICE_LIFETIME=CHANGE_ME_stripe_price_lifetime

# -----------------------------
# Crypto Payments (Coinbase Commerce)
# -----------------------------
GUARDIAN_CRYPTO_API_KEY=CHANGE_ME_coinbase_commerce_api_key

# -----------------------------
# Internal License Issuance Secret
# -----------------------------
# Keep secret. Never share with customers.
GUARDIAN_LICENSE_ISSUER_SECRET=CHANGE_TO_STRONG_INTERNAL_SECRET

# -----------------------------
# Deployment License Activation
# -----------------------------
# Set the machine-bound runtime license key for this host.
GUARDIAN_LICENSE_KEY=CHANGE_ME_license_key

# -----------------------------
# Optional SIEM / Evidence Export
# -----------------------------
GUARDIAN_SIEM_ENABLED=false
GUARDIAN_SIEM_FORMAT=json
GUARDIAN_SIEM_TRANSPORT=file
GUARDIAN_SIEM_OUT=artifacts/evidence/siem_alerts.log

# -----------------------------
# Optional Differential Privacy
# -----------------------------
GUARDIAN_DP_ENABLED=false
GUARDIAN_DP_EPSILON=1.0

