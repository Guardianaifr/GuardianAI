{
  "name": "guardianai-eliza",
  "version": "0.1.0",
  "description": "GuardianAI for ElizaOS: one command to run an Eliza agent whose payments are guarded on Monad (prompt-injection, memory-poisoning and scam-address protection), plus the plugin for your own agent.",
  "type": "module",
  "bin": { "guardianai-eliza": "dist/cli.js" },
  "main": "dist/index.js",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "esbuild src/cli.ts src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist --banner:js=\"#!/usr/bin/env node\"",
    "test": "node test/code.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": { "node": ">=20" },
  "keywords": ["elizaos", "elizaos-plugin", "guardianai", "monad", "ai-agent", "security", "prompt-injection", "wallet"],
  "homepage": "https://aiguardian.dev/explorer/?view=console",
  "license": "MIT",
  "dependencies": {
    "@elizaos/core": "1.7.2",
    "@elizaos/plugin-bootstrap": "1.7.2",
    "@elizaos/plugin-groq": "1.0.4",
    "@elizaos/plugin-sql": "1.7.2",
    "viem": "^2.57.4"
  },
  "devDependencies": { "esbuild": "^0.25.0" }
}
