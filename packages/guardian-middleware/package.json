{
  "name": "@guardianai/middleware",
  "version": "1.1.0",
  "type": "module",
  "description": "GuardianAI agent middleware: guarded payments on Monad for ElizaOS 1.x, viem and any EVM agent, with prompt-injection and memory-poisoning protection.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "node test/run-tests.js && node test/guarded-wallet.test.ts",
    "test:live": "LIVE=1 node test/guarded-wallet.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "eliza:setup": "node examples/eliza-agent/setup.mjs",
    "eliza:demo": "node examples/eliza-agent/demo.mjs",
    "eliza:chat": "node examples/eliza-agent/chat.mjs"
  },
  "keywords": [
    "ai-agents",
    "eip712",
    "elizaos",
    "elizaos-plugin",
    "guarded-wallet",
    "guardianai",
    "guardrails",
    "monad",
    "security",
    "viem"
  ],
  "author": "GuardianAI Security Labs",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./elizaos": "./src/elizaos.ts",
    "./guarded-wallet": "./src/guarded-wallet.ts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.7.0",
    "viem": ">=2.20.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2",
    "@elizaos/plugin-bootstrap": "1.7.2",
    "@elizaos/plugin-groq": "1.0.4",
    "@elizaos/plugin-sql": "1.7.2",
    "ethers": "^6.17.0",
    "typescript": "^5.6.0",
    "viem": "^2.57.4"
  }
}
