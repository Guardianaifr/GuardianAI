GUARDIAN_ADMIN_USER=admin
GUARDIAN_ADMIN_PASS=REPLACE_WITH_STRONG_PASSWORD
GUARDIAN_BACKEND_TOKEN=REPLACE_WITH_STRONG_TOKEN
GUARDIAN_SERVICE_AUTH_TOKEN=REPLACE_WITH_STRONG_TOKEN
GUARDIAN_SERVICE_ID=guardian-proxy
GUARDIAN_ADMIN_BYPASS_TOKEN=REPLACE_WITH_STRONG_TOKEN
GUARDIAN_WSGI_SERVER=waitress
GUARDIAN_WSGI_THREADS=16
# Optional: provide only when you have a valid feed URL.
# GUARDIAN_THREAT_FEED_URL=https://example.com/threat-feed.yaml

# Refuse /api/v1/attest for any agent not registered to an operator passkey
# (config/agent_passkey_identities.json). Without this, agent_id is caller-supplied for unregistered agents.
GUARDIAN_REQUIRE_AGENT_CARD=1
