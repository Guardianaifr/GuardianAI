{
  "hosting": [
    {
      "target": "guardian-target",
      "public": "website",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/explorer",
          "destination": "/explorer/",
          "type": 301
        },
        {
          "source": "/mera",
          "destination": "/mera/",
          "type": 301
        },
        {
          "source": "/boost",
          "destination": "/",
          "type": 302
        },
        {
          "source": "/boost/**",
          "destination": "/",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/explorer/**",
          "destination": "/explorer/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "**/*.@(css|js|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    }
  ]
}
