# ==============================================================================
# GuardianAI Enterprise Configuration Template (2026 Production Standard)
# ==============================================================================
# IMPORTANT: Copy this file to `.env` and configure all parameters prior to deployment.
# Under production environment mode (GUARDIAN_ENV=production), the application will
# fail-fast and refuse to start if default credentials or keys are detected.

# ------------------------------------------------------------------------------
# Authentication & Management
# ------------------------------------------------------------------------------
# CRITICAL: Change both administrative username and password in production.
# The default password 'guardian_default' is blocked under production mode.
GUARDIAN_ADMIN_USER=admin
GUARDIAN_ADMIN_PASS=

# Database storage path (use /app/data/guardian.db for Docker persistence)
# GUARDIAN_DB_PATH=guardian.db

# ------------------------------------------------------------------------------
# Cryptographic Keys (Tokens & Verification Badges)
# ------------------------------------------------------------------------------
# CRITICAL: Generate a strong random secret key. Default 'dev_secret_key' or
# 'guardian_jwt_dev_secret_change_me' will cause startup/verification failure in production.
# You can generate a key using: openssl rand -hex 32
GUARDIAN_JWT_SECRET=

# ------------------------------------------------------------------------------
# Network & Proxy Setup
# ------------------------------------------------------------------------------
# Set to 'production' to enforce strict security controls (e.g. JWT secret checks,
# credential validation, TLS requirements). Defaults to 'development'.
GUARDIAN_ENV=production

# The public URL of the SaaS dashboard (used for CORS and redirect configurations)
# GUARDIAN_PUBLIC_BASE_URL=https://guardian-admin.example.com

# Target LLM server configuration (Ollama, LocalAI, vLLM, llama.cpp, etc.)
# TARGET_URL=http://host.docker.internal:8080

# ------------------------------------------------------------------------------
# Redis Security
# ------------------------------------------------------------------------------
# Redis password used for secure connection authentication (requires matching
# value in docker-compose.yml / redis-server).
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Billing & Licensing (Stripe & DRM Setup)
# ------------------------------------------------------------------------------
GUARDIAN_BILLING_MODE=mock
# GUARDIAN_STRIPE_SECRET_KEY=
# GUARDIAN_STRIPE_PRICE_LIFETIME=
# GUARDIAN_CRYPTO_API_KEY=


# ------------------------------------------------------------------------------
# Verifiable Credentials (Passport System)
# ------------------------------------------------------------------------------
# CRITICAL: Ed25519 private key seed (hex-encoded, 32 bytes) for signing VCs.
# Required when the 'cryptography' library is unavailable (HMAC fallback mode).
# Generate with: openssl rand -hex 32
GUARDIAN_VC_PRIVATE_KEY=
# Optional: previous key for rotation / backward-compat verification
# GUARDIAN_VC_PRIVATE_KEY_PREVIOUS=

# ------------------------------------------------------------------------------
# Web3 On-Chain Integration (Merkle Anchor + SBT Passports)
# ------------------------------------------------------------------------------
# Set to "live" to submit real on-chain transactions, or "simulated" (default)
# for local-only Merkle proof recording without blockchain interaction.
GUARDIAN_ANCHOR_MODE=simulated

# 0x-prefixed hex private key for the deployer wallet.
# Required only when GUARDIAN_ANCHOR_MODE=live.
# GUARDIAN_DEPLOYER_PRIVATE_KEY=

# Deployed CortexAnchor contract addresses (Monad Testnet).
# Set after running deployment scripts (Phase 3).
# GUARDIAN_CORTEX_CONTRACT_MONAD=

# Deployed InterlockRegistry contract addresses.
# GUARDIAN_INTERLOCK_CONTRACT_MONAD=

# Deployed InsuranceLedger contract addresses.
# GUARDIAN_INSURANCE_CONTRACT_MONAD=

# Deployed ThreatFeedRegistry contract addresses.
# GUARDIAN_THREATFEED_CONTRACT_MONAD=

# Deployed RiskAttestation contract addresses.
# GUARDIAN_RISK_CONTRACT_MONAD=

# ------------------------------------------------------------------------------
# Ownership Safety Check (required when GUARDIAN_ANCHOR_MODE=live)
# ------------------------------------------------------------------------------
# CRITICAL: The address of the deployed GuardianTimelock contract.
#
# When GUARDIAN_ANCHOR_MODE=live, the system calls owner() on all 5 live
# contracts before executing any on-chain transaction. If ANY contract's
# owner is still the deployer EOA (GUARDIAN_DEPLOYER_PRIVATE_KEY) instead
# of this timelock address, ALL live-mode calls are refused with a clear
# error listing the non-compliant contracts.
#
# Workflow:
#   1. Deploy GuardianTimelock:
#      npx hardhat run contracts/scripts/deploy_timelock.js
#   2. Transfer all contract ownerships to the timelock:
#      TIMELOCK_ADDRESS=<addr> [...] \
#      npx hardhat run contracts/scripts/transfer_ownership_to_timelock.js
#   3. Renounce deployer TIMELOCK_ADMIN_ROLE (see script output).
#   4. Set GUARDIAN_TIMELOCK_ADDRESS here, then set GUARDIAN_ANCHOR_MODE=live.
#
# GUARDIAN_TIMELOCK_ADDRESS=

# Safety: reject on-chain transactions if gas price exceeds this (in gwei).
GUARDIAN_MAX_GAS_PRICE_GWEI=100

# Optional: SHA-256 hash of the dynamic threat feed for supply-chain verification.
# GUARDIAN_THREAT_FEED_HASH=

# ── ERC-8004 Identity Registration (Identity step; default OFF) ──────────────
# Registers GuardianAI-protected agents on the CANONICAL ERC-8004 Identity
# Registry and links each agentId to its GuardianPassport via setMetadata.
# Disabled by default: with this flag off, nothing changes at runtime.
GUARDIAN_ERC8004_ENABLED=false

# Comma-separated chains to register on. Supported: monad-testnet only.
GUARDIAN_ERC8004_CHAINS=monad-testnet

# Dedicated registrar key (EVM private key). Use a SEPARATE key from
# GUARDIAN_DEPLOYER_PRIVATE_KEY — it signs one register()+setMetadata() pair
# per agent. Leave empty until you intend to enable the feature.
# GUARDIAN_ERC8004_REGISTRAR_KEY=

# Per-chain RPC overrides (default: Monad testnet).
# GUARDIAN_ERC8004_RPC_MONAD_TESTNET=

# Override ONLY for local fork tests — never in production.
# GUARDIAN_ERC8004_IDENTITY_REGISTRY_OVERRIDE=

# Worker tuning: poll interval (seconds) and max retries per registration.
GUARDIAN_ERC8004_POLL_SECONDS=30
GUARDIAN_ERC8004_MAX_RETRIES=5

# Denial-of-Wallet guard: max actual gas spend per UTC day across all ERC-8004
# registration txs. 0 disables the cap (not recommended for mainnet chains).
# Recommended mainnet default: 10000000000000000 (0.01 ETH).
# WARNING: When ERC-8004 is enabled with budget=0, a startup warning is logged.
GUARDIAN_ERC8004_DAILY_BUDGET_WEI=0

# ------------------------------------------------------------------------------
# Beta Mode (Pricing & Metering)
# ------------------------------------------------------------------------------
# When true, pricing enforcement is bypassed — all API calls are permitted
# regardless of tier or quota. Set to 'false' to enforce production billing.
GUARDIAN_BETA_MODE=true

# ── Identity Gate (point-of-interaction enforcement; default OFF) ─────────────
# Consults the passport registry / ERC-8004 registration before allowing an
# agent to transact (RPC relay) or make an inter-agent call (agentic control
# plane). Disabled by default — additive, does not change existing behavior
# until explicitly turned on.
GUARDIAN_IDENTITY_GATE_ENABLED=false
# enforce = actually block. shadow = log what WOULD have been blocked, allow
# everything anyway. Recommended: run shadow for a burn-in period before
# switching to enforce.
GUARDIAN_IDENTITY_GATE_MODE=enforce
# Minimum tier to allow: UNVERIFIED (revoked-only block), SILVER, GOLD, DIAMOND
GUARDIAN_IDENTITY_GATE_MIN_TIER=UNVERIFIED
# Block agents/addresses with no registered passport (true = block, false = warn+allow)
GUARDIAN_IDENTITY_GATE_UNREGISTERED_BLOCK=false
# Cross-check the on-chain ERC-8004 registry in addition to the local DB
# (requires GUARDIAN_ERC8004_ENABLED=true and a confirmed registration row)
GUARDIAN_IDENTITY_GATE_ONCHAIN_VERIFY=false
# Fail closed if the local DB or an on-chain check throws.
# Default false: identity lookups depend on infra (SQLite locks, RPC
# endpoints) that's less reliable than the calldata checks the relay
# already fails closed on — this is a DELIBERATE exception, not an oversight.
GUARDIAN_IDENTITY_GATE_FAIL_CLOSED=false
# Cache TTL seconds for identity lookups (0 disables caching)
GUARDIAN_IDENTITY_GATE_CACHE_TTL=60
# Chain to query when ONCHAIN_VERIFY=true
GUARDIAN_IDENTITY_GATE_CHAIN=monad-testnet

# ── Agentic control plane: require the identity gate on inter-agent calls ────
# Separate opt-in from GUARDIAN_IDENTITY_GATE_ENABLED above: that variable
# controls whether the gate does anything AT ALL. This config key (set in
# guardian_config.yml under the agentic section, NOT an env var) controls
# whether the agentic control plane additionally requires the check to pass.
# require_agent_identity: false   # guardian_config.yml, agentic: section

# ------------------------------------------------------------------------------
# Privy Beyond-Authentication Integration (Monad Metropolis Hackathon)
# ------------------------------------------------------------------------------
# Frontend Vite Privy Application ID (dashboard authentication & session signer delegation)
VITE_PRIVY_APP_ID=clx_guardian_demo

# Server-side Privy Application ID and App Secret (server wallet & policy engine)
PRIVY_APP_ID=clx_guardian_demo
PRIVY_APP_SECRET=your_privy_app_secret_here

# Envio indexer RPC (metropolis/indexer). Falls back to the public Monad testnet RPC if unset.
ENVIO_MONAD_RPC_URL=
# Optional WSS for live test tools
MONAD_TESTNET_WSS=

# Pay-per-approval with x402 (USDC on Monad). Off unless true.
GUARDIAN_X402_ENABLED=false
GUARDIAN_X402_PAY_TO=
GUARDIAN_X402_PRICE=$0.01
GUARDIAN_X402_NETWORK=eip155:10143
GUARDIAN_X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
GUARDIAN_X402_FREE_PER_AGENT_MONTH=0
# Test-only payer for tools/x402_e2e.py (testnet USDC only)
GUARDIAN_X402_TEST_PAYER_KEY=

# Relay safety rules
# Per-agent rules file (see config/agent_policies.example.json). Missing file = built-in caps: 1 MON/payment, 5 MON/day, 100 USDC/transfer.
GUARDIAN_AGENT_POLICIES_FILE=config/agent_policies.json
# Check every recipient against the on-chain scam list before signing (fails closed if unreadable)
GUARDIAN_THREAT_FEED_CHECK=true
GUARDIAN_THREAT_FEED_CONTRACT=0x576CC248D8c406ac302b74e7BFd571E9F989f467
