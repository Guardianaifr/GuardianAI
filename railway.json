{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "backend/**",
      "dashboard/**",
      "guardian/**",
      "requirements.txt"
    ]
  },
  "deploy": {
    "startCommand": "/app/entrypoint.sh one-click",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "GUARDIAN_ADMIN_PASS": {
      "description": "Password for the GuardianAI Admin Dashboard. Must be a strong, unique password.",
      "required": true
    },
    "PORT": {
      "description": "Railway assigned port (leave blank)",
      "required": false
    },
    "LOG_LEVEL": {
      "description": "Logging Verbosity",
      "defaultValue": "INFO",
      "required": false
    },
    "GUARDIAN_PROXY_HOST": {
      "description": "Host bind address for the security proxy",
      "defaultValue": "0.0.0.0",
      "required": false
    }
  }
}
